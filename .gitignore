# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having sub-dependencies with platform-specific binaries, it may be better to ignore the file.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, it is generally recommended to keep poetry.lock in version control.
#   For more info, see: https://python-poetry.org/docs/basic-usage/#commit-your-poetrylock-file-to-version-control
# poetry.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to keep pdm.lock in version control.
# pdm.lock
#   pdm stores project-wide configurations in .pdm.toml, but it is recommended to not include it
#   in version control.
#   See: https://pdm-project.org/latest/usage/config/#project-level-configuration
.pdm.toml

# PEP 582; used by pdm
__pypackages__/

